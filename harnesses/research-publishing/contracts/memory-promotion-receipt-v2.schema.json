{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/memory-promotion-receipt-v2/2.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "plan_id", "plan_digest", "approval_digest", "runtime_version", "status", "steps", "record_refs", "prior_catalog_digest", "final_catalog_digest", "reconciliation_required", "resume_cursor", "receipt_digest"],
  "properties": {
    "schema_version": { "const": "memory-promotion-receipt/v2" },
    "receipt_id": { "$ref": "#/$defs/id" }, "plan_id": { "$ref": "#/$defs/id" },
    "plan_digest": { "$ref": "#/$defs/digest" }, "approval_digest": { "$ref": "#/$defs/digest" },
    "runtime_version": { "enum": ["0.2.0", "0.3.0"] },
    "status": { "enum": ["complete", "partial", "failed", "reconciliation_required"] },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "record_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "prior_catalog_digest": { "$ref": "#/$defs/digest" },
    "final_catalog_digest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "reconciliation_required": { "type": "boolean" },
    "resume_cursor": { "anyOf": [{ "$ref": "#/$defs/action" }, { "type": "null" }] },
    "receipt_digest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "complete" } } }, "then": { "properties": { "final_catalog_digest": { "$ref": "#/$defs/digest" }, "reconciliation_required": { "const": false }, "resume_cursor": { "type": "null" } } } },
    { "if": { "properties": { "status": { "const": "reconciliation_required" } } }, "then": { "properties": { "reconciliation_required": { "const": true } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$" }, "text": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "action": { "enum": ["validate_mapping", "verify_evidence", "copy_source", "write_semantic_records", "write_document_records", "register_artifact", "append_log", "write_index_shards", "recheck_base_catalog", "commit_catalog"] },
    "step": { "type": "object", "additionalProperties": false, "required": ["name", "status", "artifact_ref", "checksum", "error_code", "runtime_status"], "properties": { "name": { "$ref": "#/$defs/action" }, "status": { "enum": ["pending", "started", "succeeded", "already_exists", "failed", "uncertain"] }, "artifact_ref": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] }, "checksum": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "error_code": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] }, "runtime_status": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] } } }
  }
}
