{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/publication-plan-v2/2.0",
  "title": "Publication Plan V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "run_id",
    "intent",
    "items",
    "plan_digest",
    "planned_at",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "plan_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "intent": { "$ref": "#/$defs/intent" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "plan_digest": { "$ref": "#/$defs/sha256" },
    "planned_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "text", "digest"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" },
        "reply_to": { "enum": ["previous", "target"] }
      }
    },
    "targetPost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "author", "snapshot_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "author": { "type": "string", "pattern": "^@[A-Za-z0-9_]{1,15}$" },
        "snapshot_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": { "enum": ["image", "video", "gif"] },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "platform",
        "target_account",
        "adapter",
        "mode",
        "target_post",
        "media",
        "items",
        "action"
      ],
      "properties": {
        "schema_version": { "const": "2.0" },
        "platform": { "const": "x" },
        "target_account": { "type": "string", "pattern": "^@[A-Za-z0-9_]{1,15}$" },
        "adapter": { "enum": ["manual", "browser"] },
        "mode": { "enum": ["single", "thread", "reply"] },
        "target_post": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/targetPost" }
          ]
        },
        "media": {
          "type": "array",
          "items": { "$ref": "#/$defs/media" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        },
        "action": { "const": "publish_once" }
      }
    }
  }
}
