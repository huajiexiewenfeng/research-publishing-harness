{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/x-article-materialization-receipt/v1",
  "title": "X Article Materialization Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "execution_id", "draft_id", "materialization_digest",
    "strategy", "body_block_count", "inline_image_count", "stage_seconds",
    "automation_seconds", "human_wait_seconds", "command_count", "command_ceiling",
    "observation_count", "observation_ceiling", "retry_count", "recovery_count",
    "within_budget", "preview_revision", "supersedes_receipt_digest", "issued_at",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": { "const": "x-article-materialization-receipt/v1" },
    "execution_id": { "$ref": "#/$defs/identity" },
    "draft_id": { "$ref": "#/$defs/identity" },
    "materialization_digest": { "$ref": "#/$defs/digest" },
    "strategy": { "enum": ["rich_text_anchor_import/v1", "block_materialization/v1"] },
    "body_block_count": { "$ref": "#/$defs/count" },
    "inline_image_count": { "$ref": "#/$defs/count" },
    "stage_seconds": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "automation_seconds": { "type": "number", "minimum": 0 },
    "human_wait_seconds": { "type": "number", "minimum": 0 },
    "command_count": { "$ref": "#/$defs/count" },
    "command_ceiling": { "$ref": "#/$defs/count" },
    "observation_count": { "$ref": "#/$defs/count" },
    "observation_ceiling": { "$ref": "#/$defs/count" },
    "retry_count": { "$ref": "#/$defs/count" },
    "recovery_count": { "$ref": "#/$defs/count" },
    "within_budget": { "type": "boolean" },
    "preview_revision": { "$ref": "#/$defs/digest" },
    "supersedes_receipt_digest": {
      "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "receipt_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "identity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0 }
  }
}
