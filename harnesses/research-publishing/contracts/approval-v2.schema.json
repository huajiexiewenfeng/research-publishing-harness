{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/approval-v2/2.0",
  "title": "Publication Approval V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "plan_id",
    "run_id",
    "plan_digest",
    "approval_digest",
    "target_account",
    "adapter",
    "mode",
    "scope",
    "approved_by",
    "approved_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "approval_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "plan_digest": { "$ref": "#/$defs/sha256" },
    "approval_digest": { "$ref": "#/$defs/sha256" },
    "target_account": { "type": "string", "pattern": "^@[A-Za-z0-9_]{1,15}$" },
    "adapter": { "enum": ["browser", "manual"] },
    "mode": { "enum": ["single", "thread", "reply"] },
    "scope": { "const": "publish_once" },
    "approved_by": { "type": "string", "minLength": 1 },
    "approved_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
