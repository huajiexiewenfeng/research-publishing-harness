{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/weekly-research-bridge-status/1.0",
  "title": "Weekly Research Bridge Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cycle_id", "phase", "outcome_ref", "claim_projection_ref", "increment_binding_ref", "article_expression_ref", "article_evidence_ref", "single_expression_ref", "single_evidence_ref", "blocked_reason", "updated_at", "projection_digest"],
  "properties": {
    "schema_version": { "const": "weekly-research-bridge-status/v1" },
    "cycle_id": { "$ref": "#/$defs/id" },
    "phase": { "enum": ["pending", "in_progress", "complete", "blocked"] },
    "outcome_ref": { "$ref": "#/$defs/ref" },
    "claim_projection_ref": { "$ref": "#/$defs/nullableRef" },
    "increment_binding_ref": { "$ref": "#/$defs/nullableRef" },
    "article_expression_ref": { "$ref": "#/$defs/nullableRef" },
    "article_evidence_ref": { "$ref": "#/$defs/nullableText" },
    "single_expression_ref": { "$ref": "#/$defs/nullableRef" },
    "single_evidence_ref": { "$ref": "#/$defs/nullableText" },
    "blocked_reason": { "$ref": "#/$defs/nullableText" },
    "updated_at": { "type": "string", "format": "date-time" },
    "projection_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "text": { "type": "string", "minLength": 1 },
    "ref": { "type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": { "path": { "$ref": "#/$defs/text" }, "digest": { "$ref": "#/$defs/digest" } } },
    "nullableRef": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "nullableText": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] }
  }
}
