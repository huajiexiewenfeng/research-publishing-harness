{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/visual-manifest/1.0",
  "title": "Article Visual Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "article_run_id", "bindings", "manifest_digest"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "article_run_id": { "type": "string", "minLength": 1 },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "manifest_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "relative_path", "digest", "mime_type", "alt_text", "claim_refs"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "relative_path": { "type": "string", "pattern": "^assets/", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
        "digest": { "$ref": "#/$defs/sha256" },
        "mime_type": { "enum": ["image/png", "image/jpeg", "image/webp"] },
        "alt_text": { "type": "string", "minLength": 1 },
        "claim_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "asset", "placement_ordinal", "width", "height", "byte_size", "normalization_version", "provenance", "editable_source"],
      "properties": {
        "slot_id": { "type": "string", "minLength": 1 },
        "asset": { "$ref": "#/$defs/asset" },
        "placement_ordinal": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "byte_size": { "type": "integer", "minimum": 1 },
        "normalization_version": { "type": "string", "minLength": 1 },
        "provenance": { "type": "object", "additionalProperties": false, "required": ["method", "tool", "source_digest"], "properties": { "method": { "enum": ["deterministic", "generated", "manual"] }, "tool": { "type": ["string", "null"] }, "source_digest": { "type": ["string", "null"] } } },
        "editable_source": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["relative_path", "digest"], "properties": { "relative_path": { "type": "string", "pattern": "^assets/", "not": { "pattern": "(^|/)\\.\\.(/|$)" } }, "digest": { "$ref": "#/$defs/sha256" } } }] }
      }
    }
  }
}
