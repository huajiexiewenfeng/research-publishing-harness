{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/research-index-shard/1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "shard_id", "track_id", "generation", "view", "quarter", "part", "entries", "entry_count", "status_tags", "category_tags", "shard_digest"],
  "properties": {
    "schema_version": { "const": "research-index-shard/v1" },
    "shard_id": { "$ref": "#/$defs/id" }, "track_id": { "$ref": "#/$defs/id" }, "generation": { "$ref": "#/$defs/id" },
    "view": { "$ref": "#/$defs/view" }, "quarter": { "type": "string", "pattern": "^[0-9]{4}-q[1-4]$" },
    "part": { "type": "integer", "minimum": 1 },
    "entries": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/entry" } },
    "entry_count": { "type": "integer", "minimum": 1, "maximum": 64 },
    "status_tags": { "$ref": "#/$defs/strings" }, "category_tags": { "$ref": "#/$defs/strings" },
    "shard_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$" }, "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "view": { "enum": ["mainline", "history", "working", "publication", "feedback"] },
    "strings": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "nullableText": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "record_path", "record_digest", "title", "summary", "tags", "category", "claim_status", "lifecycle_status", "evolution_target", "updated_at", "accepted_at", "published_at", "evidence_available", "document_manifest_available"],
      "properties": {
        "ref": { "$ref": "#/$defs/text" }, "record_path": { "$ref": "#/$defs/text" }, "record_digest": { "$ref": "#/$defs/digest" },
        "title": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" }, "tags": { "$ref": "#/$defs/strings" },
        "category": { "enum": ["semantic", "publication", "feedback"] },
        "claim_status": { "anyOf": [{ "enum": ["verified", "observed", "inferred", "hypothesis", "planned"] }, { "type": "null" }] },
        "lifecycle_status": { "enum": ["working", "accepted", "published", "superseded", "retracted"] },
        "evolution_target": { "$ref": "#/$defs/nullableText" },
        "updated_at": { "type": "string", "format": "date-time" }, "accepted_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "published_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "evidence_available": { "type": "boolean" }, "document_manifest_available": { "type": "boolean" }
      }
    }
  }
}
