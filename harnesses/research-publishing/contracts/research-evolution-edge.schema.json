{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/research-evolution-edge/1.0",
  "title": "Research Evolution Edge V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edge_id", "from_ref", "to_ref", "relationship", "rationale", "evidence_refs", "reviewed_by", "reviewed_at", "edge_digest"],
  "properties": {
    "schema_version": { "const": "research-evolution-edge/v1" },
    "edge_id": { "$ref": "#/$defs/id" },
    "from_ref": { "$ref": "#/$defs/text" },
    "to_ref": { "$ref": "#/$defs/text" },
    "relationship": { "enum": ["supersedes", "refines", "contradicts", "validates", "retracts", "informed_by"] },
    "rationale": { "$ref": "#/$defs/text" },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "reviewed_by": { "$ref": "#/$defs/text" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "edge_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$" },
    "text": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
