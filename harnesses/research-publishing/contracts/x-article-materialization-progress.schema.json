{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/x-article-materialization-progress/v1",
  "title": "X Article Materialization Stage Progress V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "stage",
    "asset_id",
    "elapsed_seconds",
    "waiting_for",
    "retry_count",
    "observed_effect",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": "x-article-materialization-progress/v1" },
    "execution_id": { "$ref": "#/$defs/identity" },
    "stage": { "type": "string", "minLength": 1 },
    "asset_id": {
      "anyOf": [{ "$ref": "#/$defs/identity" }, { "type": "null" }]
    },
    "elapsed_seconds": { "type": "number", "minimum": 0 },
    "waiting_for": { "type": ["string", "null"], "minLength": 1 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "observed_effect": { "enum": ["none", "partial", "complete", "unknown"] },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "identity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" }
  }
}
