{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/x-article-browser-observation/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "execution_id", "command_id", "origin", "canonical_url", "page_revision", "observed_at", "account_handle", "page_kind", "controls", "editor", "preview", "publish_review", "public_article"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "observation_id": { "type": "string", "minLength": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "command_id": { "type": "string", "minLength": 1 },
    "origin": { "const": "https://x.com" },
    "canonical_url": { "type": "string", "format": "uri", "pattern": "^https://x\\.com/" },
    "page_revision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "observed_at": { "type": "string", "format": "date-time" },
    "account_handle": { "type": ["string", "null"] },
    "page_kind": { "enum": ["articles_index", "article_editor", "article_preview", "publish_review", "public_article", "login_required", "security_challenge"] },
    "controls": { "type": "array", "items": { "$ref": "#/$defs/control" } },
    "editor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/editor" }] },
    "preview": { "type": ["object", "null"] },
    "publish_review": { "type": ["object", "null"] },
    "public_article": { "type": ["object", "null"] }
  },
  "$defs": {
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "role", "name", "test_id", "disabled"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "test_id": { "type": ["string", "null"] },
        "disabled": { "type": "boolean" }
      }
    },
    "editor": {
      "type": "object", "additionalProperties": false,
      "required": ["draft_id", "title", "blocks", "visuals", "has_unknown_content", "autosave_state"],
      "properties": {
        "draft_id": { "type": "string", "pattern": "^[0-9]+$" },
        "title": { "type": "string" },
        "blocks": { "type": "array", "items": { "type": "object" } },
        "visuals": { "type": "array", "items": { "type": "object" } },
        "has_unknown_content": { "type": "boolean" },
        "autosave_state": { "enum": ["saving", "saved", "failed"] }
      }
    }
  }
}
