{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/article-draft/1.0",
  "title": "Article Draft Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "title", "summary", "language", "sections", "open_questions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "language": { "enum": ["en", "zh-CN"] },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "markdown", "claim_refs", "source_refs"],
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "section_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
          "markdown": { "type": "string", "minLength": 1 },
          "claim_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "visual_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "placement", "purpose", "required", "brief", "claim_refs"],
        "properties": {
          "slot_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
          "placement": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "cover" } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "section_id"], "properties": { "kind": { "const": "after_section" }, "section_id": { "type": "string", "minLength": 1 } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "heading_id", "heading_text"], "properties": { "kind": { "const": "after_heading" }, "heading_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" }, "heading_text": { "type": "string", "minLength": 1 } } }
            ]
          },
          "purpose": { "enum": ["cover", "explanation", "architecture", "evidence"] },
          "required": { "type": "boolean" },
          "brief": { "type": "string", "minLength": 1 },
          "claim_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
