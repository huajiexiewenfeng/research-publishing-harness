{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/publish-receipt/1.0",
  "title": "Publish Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "run_id", "publication_digest", "adapter",
    "status", "verification_source", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "publication_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "adapter": { "const": "manual" },
    "status": { "enum": ["handed_off", "manual_recorded", "failed"] },
    "verification_source": { "const": "manual" },
    "preview_path": { "type": "string", "minLength": 1 },
    "public_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "post_ids", "published_at"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "post_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "published_at": { "type": "string", "format": "date-time" }
      }
    },
    "error": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
