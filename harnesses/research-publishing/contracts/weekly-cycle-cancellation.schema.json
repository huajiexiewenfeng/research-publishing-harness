{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/weekly-cycle-cancellation/1.0",
  "title": "Weekly Cycle Cancellation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cancellation_id", "cycle_ref", "selection_ref", "reason", "cancelled_by", "cancelled_at", "cancellation_digest"],
  "properties": {
    "schema_version": { "const": "weekly-cycle-cancellation/v1" },
    "cancellation_id": { "$ref": "#/$defs/stableId" },
    "cycle_ref": { "$ref": "#/$defs/artifactRef" },
    "selection_ref": { "$ref": "#/$defs/artifactRef" },
    "reason": { "$ref": "#/$defs/nonEmpty" },
    "cancelled_by": { "$ref": "#/$defs/nonEmpty" },
    "cancelled_at": { "type": "string", "format": "date-time" },
    "cancellation_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stableId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": { "path": { "$ref": "#/$defs/nonEmpty" }, "digest": { "$ref": "#/$defs/digest" } }
    }
  }
}
