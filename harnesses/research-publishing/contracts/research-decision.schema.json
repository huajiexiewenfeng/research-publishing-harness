{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/research-decision/1.0",
  "title": "Research Decision V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "statement", "rationale", "alternatives", "evidence_refs", "increment_ref", "status", "decision_digest"],
  "properties": {
    "schema_version": { "const": "research-decision/v1" },
    "decision_id": { "$ref": "#/$defs/id" },
    "statement": { "$ref": "#/$defs/text" },
    "rationale": { "$ref": "#/$defs/text" },
    "alternatives": { "$ref": "#/$defs/refs" },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "increment_ref": { "$ref": "#/$defs/text" },
    "status": { "enum": ["active", "superseded", "retracted"] },
    "decision_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$" },
    "text": { "type": "string", "minLength": 1 },
    "refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
