{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/claim-version/1.0",
  "title": "Claim Version V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "version", "statement", "claim_status", "evidence_refs", "boundary_refs", "increment_ref", "evolution_refs", "summary", "claim_digest"],
  "properties": {
    "schema_version": { "const": "claim-version/v1" },
    "claim_id": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "statement": { "$ref": "#/$defs/text" },
    "claim_status": { "enum": ["verified", "observed", "inferred", "hypothesis", "planned"] },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "boundary_refs": { "$ref": "#/$defs/refs" },
    "increment_ref": { "$ref": "#/$defs/text" },
    "evolution_refs": { "$ref": "#/$defs/refs" },
    "summary": { "$ref": "#/$defs/text" },
    "claim_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$" },
    "text": { "type": "string", "minLength": 1 },
    "refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
