{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/visual-asset-ref/1.0",
  "title": "Visual Asset Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "relative_path", "digest", "mime_type", "alt_text", "claim_refs"],
  "properties": {
    "asset_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
    "relative_path": { "type": "string", "pattern": "^assets/[A-Za-z0-9._/-]+$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "mime_type": { "enum": ["image/png", "image/jpeg", "image/webp"] },
    "alt_text": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "claim_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
