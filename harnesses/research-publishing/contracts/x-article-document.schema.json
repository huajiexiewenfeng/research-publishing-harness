{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/x-article-document/1.0",
  "title": "X Article Document V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "cover_asset_id", "blocks"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "cover_asset_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+$" },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "runs"],
            "properties": {
              "kind": { "enum": ["heading", "subheading", "paragraph", "quote"] },
              "runs": { "$ref": "#/$defs/runs" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "items"],
            "properties": {
              "kind": { "enum": ["bullet_list", "ordered_list"] },
              "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/runs" } }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "asset_id", "alt_text"],
            "properties": {
              "kind": { "const": "image" },
              "asset_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
              "alt_text": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "marks", "link"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "marks": { "type": "array", "uniqueItems": true, "items": { "enum": ["bold", "italic"] } },
          "link": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" }
        }
      }
    }
  }
}
