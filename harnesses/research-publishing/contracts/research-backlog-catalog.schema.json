{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/research-backlog-catalog/1.0",
  "title": "Research Backlog Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "roadmap_ref", "entries", "counts", "rebuilt_at", "catalog_digest"],
  "properties": {
    "schema_version": { "const": "research-backlog-catalog/v1" },
    "roadmap_ref": { "$ref": "#/$defs/artifactRef" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_ready", "researching", "long_term"],
      "properties": {
        "evidence_ready": { "$ref": "#/$defs/count" },
        "researching": { "$ref": "#/$defs/count" },
        "long_term": { "$ref": "#/$defs/count" }
      }
    },
    "rebuilt_at": { "type": "string", "format": "date-time" },
    "catalog_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stableId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": { "path": { "$ref": "#/$defs/nonEmpty" }, "digest": { "$ref": "#/$defs/digest" } }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["topic_id", "current_revision_ref", "backlog_state", "availability", "claim_status"],
      "properties": {
        "topic_id": { "$ref": "#/$defs/stableId" },
        "current_revision_ref": { "$ref": "#/$defs/artifactRef" },
        "backlog_state": { "enum": ["evidence_ready", "researching", "long_term"] },
        "availability": { "enum": ["available", "reserved", "completed", "retired"] },
        "claim_status": { "enum": ["shipped", "validated", "observed", "exploring", "planned", "hypothesis"] }
      }
    }
  }
}
