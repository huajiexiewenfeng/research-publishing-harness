{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/x-article-publication-preflight/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_document_digest",
    "sanitized_document",
    "sanitized_document_digest",
    "removals",
    "cover",
    "inline_assets",
    "preflight_digest"
  ],
  "properties": {
    "schema_version": { "const": "x-article-publication-preflight/v1" },
    "source_document_digest": { "$ref": "#/$defs/digest" },
    "sanitized_document": { "$ref": "#/$defs/document" },
    "sanitized_document_digest": { "$ref": "#/$defs/digest" },
    "removals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_ordinal", "block_digest", "text", "reason"],
        "properties": {
          "block_ordinal": { "type": "integer", "minimum": 1 },
          "block_digest": { "$ref": "#/$defs/digest" },
          "text": { "type": "string", "minLength": 1 },
          "reason": { "enum": ["draft_status", "evidence_review_date"] }
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_digest", "alt_text"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/asset_id" },
        "asset_digest": { "$ref": "#/$defs/digest" },
        "alt_text": { "$ref": "#/$defs/alt_text" }
      }
    },
    "inline_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "block_ordinal", "asset_digest", "alt_text"],
        "properties": {
          "asset_id": { "$ref": "#/$defs/asset_id" },
          "block_ordinal": { "type": "integer", "minimum": 1 },
          "asset_digest": { "$ref": "#/$defs/digest" },
          "alt_text": { "$ref": "#/$defs/alt_text" }
        }
      }
    },
    "preflight_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "asset_id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
    "alt_text": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": ".*\\S.*" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "marks", "link"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "marks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["bold", "italic"] }
        },
        "link": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "title", "cover_asset_id", "blocks"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "title": { "type": "string", "minLength": 1 },
        "cover_asset_id": { "$ref": "#/$defs/asset_id" },
        "blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "runs"],
                "properties": {
                  "kind": { "enum": ["heading", "subheading", "paragraph", "quote"] },
                  "runs": { "$ref": "#/$defs/runs" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "items"],
                "properties": {
                  "kind": { "enum": ["bullet_list", "ordered_list"] },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/runs" }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "asset_id", "alt_text"],
                "properties": {
                  "kind": { "const": "image" },
                  "asset_id": { "$ref": "#/$defs/asset_id" },
                  "alt_text": { "$ref": "#/$defs/alt_text" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
