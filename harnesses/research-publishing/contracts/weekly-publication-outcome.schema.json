{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/weekly-publication-outcome/1.0",
  "title": "Weekly Publication Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcome_id", "cycle_ref", "roadmap_ref", "topic_ref", "selection_ref", "research_content_package_ref", "weekly_article_ref", "article_package_ref", "bundle_plan_ref", "bundle_approval_ref", "bundle_receipt_ref", "article", "single", "public_urls", "research_stream_ids", "package_claim_refs", "package_evidence_refs", "package_boundary_refs", "package_open_question_refs", "issued_at", "outcome_digest"],
  "properties": {
    "schema_version": { "const": "weekly-publication-outcome/v1" },
    "outcome_id": { "$ref": "#/$defs/stableId" },
    "cycle_ref": { "$ref": "#/$defs/artifactRef" },
    "roadmap_ref": { "$ref": "#/$defs/artifactRef" },
    "topic_ref": { "$ref": "#/$defs/artifactRef" },
    "selection_ref": { "$ref": "#/$defs/artifactRef" },
    "research_content_package_ref": { "$ref": "#/$defs/artifactRef" },
    "weekly_article_ref": { "$ref": "#/$defs/artifactRef" },
    "article_package_ref": { "$ref": "#/$defs/artifactRef" },
    "bundle_plan_ref": { "$ref": "#/$defs/artifactRef" },
    "bundle_approval_ref": { "$ref": "#/$defs/artifactRef" },
    "bundle_receipt_ref": { "$ref": "#/$defs/artifactRef" },
    "article": { "$ref": "#/$defs/publishedChild" },
    "single": { "$ref": "#/$defs/publishedChild" },
    "public_urls": { "type": "array", "prefixItems": [{ "$ref": "#/$defs/httpsUrl" }, { "$ref": "#/$defs/httpsUrl" }], "items": false, "minItems": 2, "maxItems": 2 },
    "research_stream_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["knowledge_runtime_governance", "project_harness_lifecycle", "skill_cognitive_runtime", "runtime_evolution", "enterprise_validation"] } },
    "package_claim_refs": { "$ref": "#/$defs/stringRefs" },
    "package_evidence_refs": { "$ref": "#/$defs/stringRefs" },
    "package_boundary_refs": { "$ref": "#/$defs/stringRefs" },
    "package_open_question_refs": { "$ref": "#/$defs/stringRefs" },
    "issued_at": { "type": "string", "format": "date-time" },
    "outcome_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "safePath": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$" },
    "artifactRef": { "type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": { "path": { "$ref": "#/$defs/safePath" }, "digest": { "$ref": "#/$defs/digest" } } },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "stringRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "publishedChild": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_ref", "receipt_ref", "public_url", "published_at", "verification_status", "limitations"],
      "properties": {
        "plan_ref": { "$ref": "#/$defs/artifactRef" },
        "receipt_ref": { "$ref": "#/$defs/artifactRef" },
        "public_url": { "$ref": "#/$defs/httpsUrl" },
        "published_at": { "type": "string", "format": "date-time" },
        "verification_status": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
