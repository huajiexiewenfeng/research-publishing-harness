{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/research-evidence-snapshot/1.0",
  "title": "Research Evidence Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_snapshot_id", "increment_id", "increment_revision", "capture_event", "capture_kind", "workspace_identity_digest", "artifact_refs", "source_refs", "privacy_classification", "capture_policy_version", "captured_at", "snapshot_digest"],
  "properties": {
    "schema_version": { "const": "research-evidence-snapshot/v1" },
    "evidence_snapshot_id": { "$ref": "#/$defs/id" },
    "increment_id": { "$ref": "#/$defs/id" },
    "increment_revision": { "type": "integer", "minimum": 1 },
    "capture_event": { "enum": ["working_checkpoint", "research_package_finalized", "article_finalized", "publication_intent_approved", "publication_receipt_terminal", "feedback_selected", "candidate_insight_created"] },
    "capture_kind": { "enum": ["automatic_terminal", "explicit_working_checkpoint", "explicit_import"] },
    "workspace_identity_digest": { "$ref": "#/$defs/digest" },
    "artifact_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "source_refs": { "$ref": "#/$defs/refs" },
    "privacy_classification": { "$ref": "#/$defs/privacy" },
    "capture_policy_version": { "const": "research-evidence-capture/v1" },
    "captured_at": { "type": "string", "format": "date-time" },
    "snapshot_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "privacy": { "enum": ["public", "internal", "restricted", "data_only"] },
    "refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "role", "workspace_relative_path", "object_path", "digest", "media_type", "byte_size", "canonical", "privacy_classification"],
      "properties": {
        "schema_version": { "const": "2.3" },
        "role": { "enum": ["canonical_article", "research_package", "claim_map", "sources", "boundary", "lineage", "article_metadata", "review_report", "visual_review_report", "visual_asset", "publication_plan", "publication_receipt", "feedback_snapshot", "candidate_insight"] },
        "workspace_relative_path": { "type": "string", "minLength": 1 },
        "object_path": { "type": "string", "pattern": "^memory/evidence/objects/sha256/[a-f0-9]{2}/[a-f0-9]{64}$" },
        "digest": { "$ref": "#/$defs/digest" },
        "media_type": { "type": "string", "minLength": 1 },
        "byte_size": { "type": "integer", "minimum": 0 },
        "canonical": { "type": "boolean" },
        "privacy_classification": { "$ref": "#/$defs/privacy" }
      }
    }
  }
}
