{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rph://contracts/visual-review-report/1.0",
  "title": "Visual Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "article_run_id", "selected_candidates", "claim_alignment", "boundary_alignment", "mobile_legibility", "single_message", "privacy_review", "reviewed_by", "reviewed_at", "passed", "findings"],
  "properties": {
    "schema_version": { "const": "1.0" }, "article_run_id": { "type": "string", "minLength": 1 },
    "selected_candidates": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "claim_alignment": { "type": "boolean" }, "boundary_alignment": { "type": "boolean" }, "mobile_legibility": { "type": "boolean" }, "single_message": { "type": "boolean" }, "privacy_review": { "type": "boolean" },
    "reviewed_by": { "type": "string", "minLength": 1 }, "reviewed_at": { "type": "string", "format": "date-time" }, "passed": { "type": "boolean" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["error", "warning"] },
          "message": { "type": "string", "minLength": 1 },
          "path": { "type": "string" }
        }
      }
    }
  }
}
